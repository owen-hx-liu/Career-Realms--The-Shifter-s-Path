[node name="InstructionsText" type="RichTextLabel" parent="ContentPanel/MarginContainer/VBoxContainer/ScrollContainer"]
custom_minimum_size = Vector2(800, 400)
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 1, 1)
bbcode_enabled = true
text = "[center][font_size=28][color=cyan]MISSION BRIEFING[/color][/font_size][/center]

[font_size=20][color=yellow]OBJECTIVE:[/color][/font_size]
The body is under attack by [color=red]5 dangerous pathogens[/color]! You must assemble a team of [color=cyan]5 immune cells[/color] to defend against them.

[font_size=20][color=yellow]HOW TO PLAY:[/color][/font_size]

[color=lime]1. ANALYZE THE THREAT[/color]
   • Look at the [color=red]pathogen cards[/color] on the left
   • Note their type, HP, attack power, and weaknesses

[color=lime]2. BUILD YOUR TEAM[/color]
   • Select [color=cyan]5 immune cells[/color] from the right side
   • Each cell has unique abilities and strengths
   • Click a cell to add it to your team
   • Click again to remove it

[color=lime]3. DEPLOY & SCORE[/color]
   • Press \"DEPLOY IMMUNE RESPONSE\" when ready
   • Your team will be evaluated against the pathogens
   • Earn stars based on your strategy!

[font_size=20][color=yellow]SCORING SYSTEM:[/color][/font_size]

[color=lime]⭐⭐⭐⭐⭐ Perfect Match:[/color] +50 points
   • Your immune cell is the pathogen's exact weakness!

[color=cyan]⭐⭐⭐ Good Match:[/color] +30 points
   • Your cell is strong against that pathogen type

[color=gray]⭐ Neutral:[/color] +10 points
   • Standard effectiveness

[color=red]✗ Bad Match:[/color] -10 points
   • Pathogen resists your immune cell

[color=yellow]+ Survival Bonus:[/color] +20 points
   • Your cell has more HP than the pathogen's attack

[font_size=20][color=yellow]STRATEGY TIPS:[/color][/font_size]

- [b]Read the weaknesses[/b] - Each pathogen card shows what it's weak to
- [b]Diversify your team[/b] - Cover multiple pathogen types
- [b]Balance offense and defense[/b] - Consider both attack power and HP
- [b]Use special abilities[/b] - Support cells can boost your entire team

[center][color=lime]Good luck, Commander! The body's defense depends on you![/color][/center]"
fit_content = true

