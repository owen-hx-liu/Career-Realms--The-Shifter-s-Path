extends Node2D
# =============================================================================
#  PRISM ARRAY  —  "The Art of Light"   ·  self-contained pixel-art laser puzzle
# =============================================================================
# A photonics-lab puzzle: a laser EMITTER fires a beam across an optical grid.
# Drop MIRRORS to bend it and PRISMS to recolour it, threading the light through
# every CRYSTAL so each lights in the colour it craves.  Three chambers of
# rising difficulty; the fewer pieces you use, the more of the 5 stars you keep.
#
# Built in the same house style as the NANOBOT SURGEON / IMMUNE / XENO remasters:
#   * all art generated by tools/make_laser.py -> assets/generated/laser/
#   * the determination pixel font on every label & button
#   * beveled 9-slice StyleBoxTexture panels & buttons, animated star sprites
#   * everything anchored inside 1152x648 (overlays via CenterContainer)
#
# Wiring: launched from Ashley's art house; records stars as laser_quest / "Art";
# returns to the ArtHouse when finished.
# =============================================================================

const ART := "res://assets/generated/laser/"
const FONT_PATH := "res://art/Dialogue/determination.ttf"

@export var return_scene: String = "res://scenes/maps/ArtHouse.tscn"
@export var quest_id: String = "laser_quest"
@export var domain: String = "Art"
var record_on_win := true                       # harness sets false

# ---- board geometry (sized to 1152x648) -------------------------------------
const GW := 12
const GH := 7
const CELL := 64
const BOARD := Rect2(192, 96, GW * CELL, GH * CELL)   # 768 x 448, centred

# ---- colour palette ---------------------------------------------------------
const COLORS := {
	"white":   Color("f4f7ff"),
	"red":     Color("ff4d5e"),
	"amber":   Color("ffb12e"),
	"green":   Color("46e35a"),
	"cyan":    Color("34e0ff"),
	"blue":    Color("5a7dff"),
	"magenta": Color("ff5ad0"),
}

# ---- chambers (each authored with a known solution for the verifier) --------
# dirs: R L U D ; mirror orient: "/" or "\\"
const CHAMBERS := [
	{
		"name": "FIRST LIGHT",
		"hint": "Bounce the beam off a mirror to pour it into the crystal.",
		"emitter": {"cell": Vector2i(0, 1), "dir": "R", "color": "cyan"},
		"walls": [Vector2i(5, 3), Vector2i(6, 3), Vector2i(2, 5)],
		"targets": [{"cell": Vector2i(8, 5), "color": "cyan"}],
		"prism_colors": ["cyan"],
		"mirrors": 4, "prisms": 0, "par": 1,
		"solution": [{"t": "mirror", "cell": Vector2i(8, 1), "o": "\\"}],
	},
	{
		"name": "PRISM SPLIT",
		"hint": "Light the red crystal, then refract the beam blue for the next.",
		"emitter": {"cell": Vector2i(0, 3), "dir": "R", "color": "red"},
		"walls": [Vector2i(2, 1), Vector2i(7, 5), Vector2i(7, 1)],
		"targets": [{"cell": Vector2i(4, 3), "color": "red"},
					{"cell": Vector2i(9, 5), "color": "blue"}],
		"prism_colors": ["blue", "red"],
		"mirrors": 4, "prisms": 3, "par": 2,
		"solution": [{"t": "prism", "cell": Vector2i(6, 3), "color": "blue"},
					 {"t": "mirror", "cell": Vector2i(9, 3), "o": "\\"}],
	},
	{
		"name": "THE GAUNTLET",
		"hint": "One beam, three crystals. Recolour as you weave it across the lab.",
		"emitter": {"cell": Vector2i(0, 0), "dir": "R", "color": "amber"},
		"walls": [Vector2i(3, 1), Vector2i(7, 4), Vector2i(8, 5), Vector2i(9, 2),
				  Vector2i(3, 5), Vector2i(10, 6), Vector2i(6, 5), Vector2i(7, 1)],
		"targets": [{"cell": Vector2i(2, 0), "color": "amber"},
					{"cell": Vector2i(3, 3), "color": "cyan"},
					{"cell": Vector2i(1, 6), "color": "magenta"}],
		"prism_colors": ["cyan", "magenta", "amber"],
		"mirrors": 6, "prisms": 4, "par": 5,
		"solution": [{"t": "mirror", "cell": Vector2i(5, 0), "o": "\\"},
					 {"t": "prism", "cell": Vector2i(5, 1), "color": "cyan"},
					 {"t": "mirror", "cell": Vector2i(5, 3), "o": "/"},
					 {"t": "mirror", "cell": Vector2i(1, 3), "o": "/"},
					 {"t": "prism", "cell": Vector2i(1, 5), "color": "magenta"}],
	},
]

enum Phase { INTRO, PLAY, INTERSTITIAL, VICTORY }

# ---- state ------------------------------------------------------------------
var _tex := {}
var _theme: Theme
var phase: int = Phase.INTRO
var level_index := 0
var elapsed := 0.0
var pieces_used_total := 0
var par_total := 0

var emitter_cell := Vector2i.ZERO
var emitter_dir := Vector2i.RIGHT
var emitter_color := "white"
var walls := {}                  # Vector2i -> true
var targets := []                # [{cell, color, lit, socket, gem, glow, _was}]
var pieces := {}                 # Vector2i -> {type, orient, color, node, glow}
var prism_palette := ["cyan"]

var tool := "mirror"
var mirrors_left := 0
var prisms_left := 0
var beam_segments := []          # [{a:Vector2, b:Vector2, c:Color}]
var has_hover := false
var hover_cell := Vector2i.ZERO
var hover_kind := "none"         # place / edit / blocked / nostock
var _primary: Callable = Callable()

# ---- nodes ------------------------------------------------------------------
var bg_layer: CanvasLayer
var world: Node2D
var tiles_root: Node2D
var optics_root: Node2D
var fx_root: Node2D
var beam_node: Node2D
var emitter_node: Sprite2D
var muzzle_glow: Sprite2D
var hud: CanvasLayer
var overlay: CanvasLayer
var toast: Label
var lbl_chamber: Label
var lbl_lit: Label
var btn_mirror: Button
var btn_prism: Button


# =============================================================================
func _ready() -> void:
	randomize()
	_load_textures()
	_theme = Theme.new()
	if ResourceLoader.exists(FONT_PATH):
		_theme.default_font = load(FONT_PATH)
	_theme.default_font_size = 18

	_build_background()
	world = Node2D.new()
	add_child(world)
	tiles_root = Node2D.new(); tiles_root.z_index = 0; world.add_child(tiles_root)
	beam_node = _Beam.new(); beam_node.quest = self; beam_node.z_index = 6; world.add_child(beam_node)
	optics_root = Node2D.new(); optics_root.z_index = 10; world.add_child(optics_root)
	fx_root = Node2D.new(); fx_root.z_index = 30; world.add_child(fx_root)

	_build_hud()
	_build_overlay()
	_show_intro()


func _load_textures() -> void:
	for n in ["bg", "frame_panel", "frame_window", "frame_banner", "button",
			"slot_off", "slot_on", "cell", "wall", "emitter", "mirror", "prism",
			"socket", "gem", "glow", "spark", "icon_mirror", "icon_prism",
			"icon_target", "star_full", "star_empty"]:
		var p: String = ART + n + ".png"
		_tex[n] = load(p) if ResourceLoader.exists(p) else null


# ---- construction -----------------------------------------------------------
func _build_background() -> void:
	bg_layer = CanvasLayer.new()
	bg_layer.layer = -10
	add_child(bg_layer)
	var tr := TextureRect.new()
	tr.texture = _tex.get("bg")
	tr.set_anchors_preset(Control.PRESET_FULL_RECT)
	tr.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	tr.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	tr.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	bg_layer.add_child(tr)


func cell_center(v: Vector2i) -> Vector2:
	return Vector2(BOARD.position.x + v.x * CELL + CELL * 0.5,
				   BOARD.position.y + v.y * CELL + CELL * 0.5)


func _in_grid(v: Vector2i) -> bool:
	return v.x >= 0 and v.x < GW and v.y >= 0 and v.y < GH


func _new_sprite(tex_name: String, pos: Vector2, parent: Node2D, z := 0,
		scale := 1.0) -> Sprite2D:
	var s := Sprite2D.new()
	s.texture = _tex.get(tex_name)
	s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	s.position = pos
	s.z_index = z
	s.scale = Vector2(scale, scale)
	parent.add_child(s)
	return s


# =============================================================================
#  Level setup
# =============================================================================
func _clear_level() -> void:
	for c in tiles_root.get_children(): c.queue_free()
	for c in optics_root.get_children(): c.queue_free()
	for c in fx_root.get_children(): c.queue_free()
	targets.clear()
	pieces.clear()
	walls.clear()
	beam_segments.clear()
	emitter_node = null
	muzzle_glow = null


func _start_level(idx: int) -> void:
	level_index = idx
	var cfg = CHAMBERS[idx]
	_clear_level()

	# board tiles
	for r in range(GH):
		for c in range(GW):
			var v := Vector2i(c, r)
			_new_sprite("cell", cell_center(v), tiles_root, 0, CELL / 32.0)

	# walls
	for w in cfg.walls:
		walls[w] = true
		_new_sprite("wall", cell_center(w), tiles_root, 2, CELL / 32.0)

	# emitter
	emitter_cell = cfg.emitter.cell
	emitter_dir = _dir_vec(cfg.emitter.dir)
	emitter_color = cfg.emitter.color
	muzzle_glow = _new_sprite("glow", cell_center(emitter_cell), optics_root, 9, 0.7)
	muzzle_glow.modulate = COLORS[emitter_color]
	muzzle_glow.modulate.a = 0.85
	emitter_node = _new_sprite("emitter", cell_center(emitter_cell), optics_root, 11, CELL / 36.0 * 0.92)
	emitter_node.rotation = Vector2(emitter_dir).angle()

	# targets
	for t in cfg.targets:
		var pos := cell_center(t.cell)
		var glow := _new_sprite("glow", pos, optics_root, 7, 0.9)
		glow.modulate = COLORS[t.color]; glow.modulate.a = 0.0
		var socket := _new_sprite("socket", pos, optics_root, 8, CELL / 40.0 * 0.96)
		var gem := _new_sprite("gem", pos, optics_root, 9, CELL / 26.0 * 0.62)
		targets.append({"cell": t.cell, "color": t.color, "lit": false,
			"socket": socket, "gem": gem, "glow": glow, "_was": false})

	prism_palette = cfg.prism_colors
	mirrors_left = cfg.mirrors
	prisms_left = cfg.prisms
	tool = "mirror" if cfg.mirrors > 0 else "prism"
	phase = Phase.PLAY
	_update_targets_visual()
	_refresh_toolbar()
	lbl_chamber.text = "CHAMBER  %d / %d" % [idx + 1, CHAMBERS.size()]
	_flash_toast("%s" % cfg.name, 1.7, COLORS[emitter_color])


func _dir_vec(s: String) -> Vector2i:
	match s:
		"R": return Vector2i.RIGHT
		"L": return Vector2i.LEFT
		"U": return Vector2i.UP
		"D": return Vector2i.DOWN
	return Vector2i.RIGHT


# =============================================================================
#  Beam tracing
# =============================================================================
func _reflect(dir: Vector2i, orient: String) -> Vector2i:
	if orient == "/":
		match dir:
			Vector2i.RIGHT: return Vector2i.UP
			Vector2i.LEFT:  return Vector2i.DOWN
			Vector2i.UP:    return Vector2i.RIGHT
			Vector2i.DOWN:  return Vector2i.LEFT
	else:                                   # "\"
		match dir:
			Vector2i.RIGHT: return Vector2i.DOWN
			Vector2i.LEFT:  return Vector2i.UP
			Vector2i.UP:    return Vector2i.LEFT
			Vector2i.DOWN:  return Vector2i.RIGHT
	return dir


func _target_index(cell: Vector2i) -> int:
	for i in range(targets.size()):
		if targets[i].cell == cell:
			return i
	return -1


func _trace() -> void:
	for t in targets:
		t.lit = false
	beam_segments.clear()
	var cur := emitter_cell
	var dir := emitter_dir
	var col_name: String = emitter_color
	var seg_start := cell_center(cur)
	var guard := {}
	var steps := 0
	var maxsteps := GW * GH * 6
	while steps < maxsteps:
		steps += 1
		var nxt := cur + dir
		if not _in_grid(nxt):
			beam_segments.append({"a": seg_start, "b": cell_center(nxt), "c": COLORS[col_name]})
			return
		if walls.has(nxt):
			var face := cell_center(nxt) - Vector2(dir) * (CELL * 0.5)
			beam_segments.append({"a": seg_start, "b": face, "c": COLORS[col_name]})
			return
		if pieces.has(nxt):
			var pc = pieces[nxt]
			beam_segments.append({"a": seg_start, "b": cell_center(nxt), "c": COLORS[col_name]})
			if pc.type == "mirror":
				var key := "%d,%d|%d,%d" % [nxt.x, nxt.y, dir.x, dir.y]
				if guard.has(key):
					return
				guard[key] = true
				dir = _reflect(dir, pc.orient)
			else:                                  # prism recolours, passes straight
				col_name = pc.color
			seg_start = cell_center(nxt)
			cur = nxt
			continue
		var ti := _target_index(nxt)
		if ti >= 0:
			if targets[ti].color == col_name:
				targets[ti].lit = true
			cur = nxt                              # crystals are transparent
			continue
		if nxt == emitter_cell:
			beam_segments.append({"a": seg_start, "b": cell_center(nxt), "c": COLORS[col_name]})
			return
		cur = nxt
	beam_segments.append({"a": seg_start, "b": cell_center(cur), "c": COLORS[col_name]})


func _all_lit() -> bool:
	if targets.is_empty():
		return false
	for t in targets:
		if not t.lit:
			return false
	return true


# =============================================================================
#  Main loop
# =============================================================================
func _process(delta: float) -> void:
	if phase == Phase.PLAY:
		elapsed += delta
		_update_hover()
		_trace()
		_update_targets_visual()
		_update_lit_label()
		if _all_lit():
			_level_cleared()
	beam_node.queue_redraw()


func _update_lit_label() -> void:
	if lbl_lit == null:
		return
	var lit := 0
	for t in targets:
		if t.lit:
			lit += 1
	lbl_lit.text = "CRYSTALS LIT  %d / %d" % [lit, targets.size()]


func _update_targets_visual() -> void:
	var pulse := 0.5 + 0.5 * sin(Time.get_ticks_msec() / 240.0)
	for t in targets:
		var col: Color = COLORS[t.color]
		if t.lit:
			t.gem.modulate = col.lightened(0.25)
			t.glow.modulate = Color(col.r, col.g, col.b, 0.55 + pulse * 0.35)
			t.glow.scale = Vector2(0.95 + pulse * 0.12, 0.95 + pulse * 0.12)
			if not t._was:
				_on_target_lit(t)
		else:
			t.gem.modulate = col.darkened(0.62)
			t.glow.modulate = Color(col.r, col.g, col.b, 0.0)
		t._was = t.lit


func _on_target_lit(t: Dictionary) -> void:
	var pos: Vector2 = cell_center(t.cell)
	t.gem.scale = Vector2(CELL / 26.0 * 0.95, CELL / 26.0 * 0.95)
	t.gem.create_tween().tween_property(t.gem, "scale",
		Vector2(CELL / 26.0 * 0.62, CELL / 26.0 * 0.62), 0.34).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	for i in range(12):
		_spark(pos + Vector2(randf_range(-12, 12), randf_range(-12, 12)), COLORS[t.color], true)


# =============================================================================
#  Player interaction
# =============================================================================
func _cell_at(p: Vector2) -> Vector2i:
	return Vector2i(int(floor((p.x - BOARD.position.x) / CELL)),
					int(floor((p.y - BOARD.position.y) / CELL)))


func _placeable(cell: Vector2i) -> bool:
	if not _in_grid(cell): return false
	if walls.has(cell): return false
	if cell == emitter_cell: return false
	if _target_index(cell) >= 0: return false
	return true


func _update_hover() -> void:
	var m := get_viewport().get_mouse_position()
	if not BOARD.has_point(m):
		has_hover = false
		return
	var cell := _cell_at(m)
	if not _in_grid(cell):
		has_hover = false
		return
	has_hover = true
	hover_cell = cell
	if pieces.has(cell):
		hover_kind = "edit"
	elif _placeable(cell):
		var stock := mirrors_left if tool == "mirror" else prisms_left
		hover_kind = "place" if stock > 0 else "nostock"
	else:
		hover_kind = "blocked"


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("ui_accept") and phase in [Phase.INTRO, Phase.INTERSTITIAL, Phase.VICTORY]:
		if _primary.is_valid():
			_primary.call()
		return
	if phase != Phase.PLAY:
		return
	if event is InputEventKey and event.pressed and not event.echo:
		match event.physical_keycode:
			KEY_M: _set_tool("mirror"); return
			KEY_P: _set_tool("prism"); return
			KEY_R: _reset_level(); return
	if event is InputEventMouseButton and event.pressed:
		var cell := _cell_at(event.position)
		if not _in_grid(cell):
			return
		if event.button_index == MOUSE_BUTTON_LEFT:
			_left_click(cell)
		elif event.button_index == MOUSE_BUTTON_RIGHT:
			_remove_piece(cell)


func _left_click(cell: Vector2i) -> void:
	if pieces.has(cell):
		var pc = pieces[cell]
		if pc.type == "mirror":
			pc.orient = "\\" if pc.orient == "/" else "/"
			pc.node.rotation = PI / 2 if pc.orient == "\\" else 0.0
			_pop(pc.node, CELL / 32.0)
		else:
			var i := prism_palette.find(pc.color)
			pc.color = prism_palette[(i + 1) % prism_palette.size()]
			pc.node.modulate = COLORS[pc.color]
			if pc.glow: pc.glow.modulate = Color(COLORS[pc.color].r, COLORS[pc.color].g, COLORS[pc.color].b, 0.5)
			_spark(cell_center(cell), COLORS[pc.color], true)
		return
	if not _placeable(cell):
		return
	if tool == "mirror" and mirrors_left > 0:
		_place_mirror(cell, "/")
		mirrors_left -= 1
	elif tool == "prism" and prisms_left > 0:
		_place_prism(cell, prism_palette[0])
		prisms_left -= 1
	_refresh_toolbar()


func _place_mirror(cell: Vector2i, orient: String) -> void:
	var node := _new_sprite("mirror", cell_center(cell), optics_root, 12, CELL / 32.0 * 0.9)
	node.rotation = PI / 2 if orient == "\\" else 0.0
	pieces[cell] = {"type": "mirror", "orient": orient, "color": "", "node": node, "glow": null}
	_pop(node, CELL / 32.0 * 0.9)
	_spark(cell_center(cell), Color("d4ecff"), true)


func _place_prism(cell: Vector2i, col: String) -> void:
	var pos := cell_center(cell)
	var glow := _new_sprite("glow", pos, optics_root, 11, 0.6)
	glow.modulate = Color(COLORS[col].r, COLORS[col].g, COLORS[col].b, 0.5)
	var node := _new_sprite("prism", pos, optics_root, 12, CELL / 30.0 * 0.92)
	node.modulate = COLORS[col]
	pieces[cell] = {"type": "prism", "orient": "", "color": col, "node": node, "glow": glow}
	_pop(node, CELL / 30.0 * 0.92)
	_spark(pos, COLORS[col], true)


func _remove_piece(cell: Vector2i) -> void:
	if not pieces.has(cell):
		return
	var pc = pieces[cell]
	if pc.node: pc.node.queue_free()
	if pc.glow: pc.glow.queue_free()
	if pc.type == "mirror":
		mirrors_left += 1
	else:
		prisms_left += 1
	pieces.erase(cell)
	_refresh_toolbar()


func _reset_level() -> void:
	for cell in pieces.keys():
		var pc = pieces[cell]
		if pc.node: pc.node.queue_free()
		if pc.glow: pc.glow.queue_free()
	pieces.clear()
	var cfg = CHAMBERS[level_index]
	mirrors_left = cfg.mirrors
	prisms_left = cfg.prisms
	_refresh_toolbar()
	_flash_toast("RESET", 0.6, Color("cfe6f5"))


func _set_tool(t: String) -> void:
	tool = t
	_refresh_toolbar()


# Places the current chamber's authored solution. Used by the verify harness
# (tools/laser_shot) as a built-in solvability self-test; not used in play.
func debug_solution_size() -> int:
	return CHAMBERS[level_index].solution.size()


func debug_place_piece(i: int) -> void:
	var s = CHAMBERS[level_index].solution[i]
	if s.t == "mirror":
		if mirrors_left > 0:
			_place_mirror(s.cell, s.o)
			mirrors_left -= 1
	else:
		if prisms_left > 0:
			_place_prism(s.cell, s.color)
			prisms_left -= 1
	_refresh_toolbar()


func debug_apply_solution() -> void:
	for i in range(debug_solution_size()):
		debug_place_piece(i)


# =============================================================================
#  Win flow
# =============================================================================
func _level_cleared() -> void:
	pieces_used_total += pieces.size()
	phase = Phase.INTERSTITIAL
	# celebratory beam flash already on; small delay then panel
	var grade := "CHAMBER CLEARED"
	if level_index >= CHAMBERS.size() - 1:
		_victory()
		return
	var nxt = CHAMBERS[level_index + 1]
	_show_panel(grade,
		"Every crystal sings with light.\n\nUp next: \"%s\".\n%s" % [nxt.name, nxt.hint],
		[{"text": "NEXT CHAMBER", "color": Color("2f9e5a"), "action": _next_level}],
		-1, COLORS[emitter_color])


func _next_level() -> void:
	_clear_overlay()
	_primary = Callable()
	_start_level(level_index + 1)


func _star_rating() -> int:
	var extra := pieces_used_total - par_total
	if extra <= 0: return 5
	elif extra <= 2: return 4
	elif extra <= 4: return 3
	elif extra <= 6: return 2
	return 1


func _victory() -> void:
	phase = Phase.VICTORY
	var stars := _star_rating()
	if record_on_win:
		_record(stars)
	var grade := "MASTER OF LIGHT" if stars >= 5 else ("FLAWLESS OPTICS" if stars >= 4 else "ARRAY ALIGNED")
	_show_panel(grade,
		"Every chamber is ablaze. Ashley's lab hums in perfect colour.\n\nPieces used  %d        Par  %d" % [pieces_used_total, par_total],
		[{"text": "CONTINUE", "color": Color("2f9e5a"), "action": _leave},
		 {"text": "RETRY", "color": Color("3a78a8"), "action": _retry}],
		stars, Color("f6e08a"))


func _retry() -> void:
	_clear_overlay()
	_primary = Callable()
	_start_run()


func _leave() -> void:
	if return_scene != "" and ResourceLoader.exists(return_scene):
		var sm = get_node_or_null("/root/SceneManager")
		if sm and sm.has_method("change_scene"):
			sm.change_scene(return_scene)
		else:
			get_tree().change_scene_to_file(return_scene)
	else:
		get_tree().reload_current_scene()


func _record(stars: int) -> void:
	var sm = get_node_or_null("/root/StarManager")
	if sm and sm.has_method("record_quest_stars"):
		var best := stars
		if sm.has_method("get_quest_stars"):
			best = max(stars, sm.get_quest_stars(quest_id))
		sm.record_quest_stars(quest_id, domain, best, 5)
	var em = get_node_or_null("/root/EndingManager")
	if em and em.has_method("complete_quest"):
		em.complete_quest(quest_id, domain, stars)


