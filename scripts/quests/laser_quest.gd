func _tool_button(icon_name: String, text: String, action: Callable) -> Button:
	var b := Button.new()
	b.icon = _tex.get(icon_name)
	b.text = "  " + text + "  ×0"
	b.focus_mode = Control.FOCUS_NONE
	b.add_theme_font_size_override("font_size", 17)
	b.add_theme_color_override("font_color", Color("dceaf6"))
	b.add_theme_constant_override("icon_max_width", 22)
	b.add_theme_stylebox_override("normal", _frame_box("slot_off", 12, 7))
	b.add_theme_stylebox_override("hover", _frame_box("slot_off", 12, 7))
	b.add_theme_stylebox_override("pressed", _frame_box("slot_on", 12, 7))
	b.pressed.connect(action)
	return b


func _refresh_toolbar() -> void:
	if btn_mirror:
		btn_mirror.text = "  MIRROR  ×%d" % mirrors_left
		btn_mirror.add_theme_stylebox_override("normal", _frame_box(("slot_on" if tool == "mirror" else "slot_off"), 12, 7))
		btn_mirror.add_theme_stylebox_override("hover", _frame_box(("slot_on" if tool == "mirror" else "slot_off"), 12, 7))
		btn_mirror.add_theme_color_override("font_color", Color("aef4ff") if tool == "mirror" else Color("8fa6bc"))
	if btn_prism:
		btn_prism.text = "  PRISM  ×%d" % prisms_left
		btn_prism.add_theme_stylebox_override("normal", _frame_box(("slot_on" if tool == "prism" else "slot_off"), 12, 7))
		btn_prism.add_theme_stylebox_override("hover", _frame_box(("slot_on" if tool == "prism" else "slot_off"), 12, 7))
		btn_prism.add_theme_color_override("font_color", Color("aef4ff") if tool == "prism" else Color("8fa6bc"))
		btn_prism.disabled = prisms_left <= 0 and not _has_placed_prism()
	if lbl_lit:
		var lit := 0
		for t in targets:
			if t.lit: lit += 1
		lbl_lit.text = "CRYSTALS LIT  %d / %d" % [lit, targets.size()]


func _has_placed_prism() -> bool:
	for c in pieces.keys():
		if pieces[c].type == "prism":
			return true
	return false


